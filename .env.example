# Include the http protocol and the port. Do not include a trailing `/`.
# Good example: http://<SNIP>.aws.com:3000
# Bad example: <SNIP>.aws.com:3000/
API_SERVICES_LOAD_BALANCER_URL=''
# Also, leave this as an empty string if deploying to K8s.
# In K8s, it will resolve the host URL using K8s service env variables.

GEMINI_API_KEY=''
KAFKA_TOPIC=''
KAFKA_BROKER_0_URL=''
KAFKA_BROKER_1_URL=''
KAFKA_BROKER_2_URL=''

# Do not include a trailing slash.
# Good example: http://host.docker.internal:8080/recommended-titles/isbn
# Bad example: http://host.docker.internal:8080/recommended-titles/isbn/
API_RELATED_BOOKS_URL_DEV=''
API_RELATED_BOOKS_URL_PROD=''

# Set this as the same value as the PROD.
# This is an alias to the PROD value for ease of development
# for deployment to K8s without extra configs.
API_RELATED_BOOKS_URL=''

# Do not use !, @, &, or any other special character that needs to be escaped
# in DB credentials. SQLModel somehow doesn't support wrapping with ''.
# Otherwise, SQLModel will fail to communicate with the DB servers.
DB_BOOKS_USER='api-service-books'
DB_BOOKS_PASS=''
DB_BOOKS_DATABASE='bookstore-books'

DB_CUSTOMERS_USER='api-service-customers'
DB_CUSTOMERS_PASS=''
DB_CUSTOMERS_DATABASE='bookstore-customers'

# Use this for CloudFormation admin DB creds:
DB_ADMIN_USER=''
DB_ADMIN_PASS=''
DB_URL=''
DB_PORT=''

# Used for the CRM for sending emails to new customers.
# I opted to generate a Gmail app password:
#   https://myaccount.google.com/apppasswords
SMTP_SERVER_URL='smtp.gmail.com'
SMTP_SERVER_PORT='587'
SMTP_SERVER_ID='example@gmail.com'
SMTP_SERVER_PASS=''
